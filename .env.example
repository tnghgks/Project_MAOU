# Notion integration token used by the notion-task-sync skill
# (.claude/skills/notion-task-sync). Team members get this token shared
# individually — copy this file to .env and fill it in. Never commit .env.
NOTION_TOKEN=

# 컷씬 영상 등을 올려둔 버킷의 base URL. 배포(GitHub Pages) 빌드에서는
# GitHub Actions repo variable(vars.VITE_BUCKET_BASE_URL)로 주입되지만,
# 로컬 개발 모드(npm run dev / build)에서는 Vite가 .env를 직접 읽으므로
# 여기에도 채워둬야 컷씬 영상이 로드된다.
VITE_BUCKET_BASE_URL=
